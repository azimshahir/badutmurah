---
// Renders a quotation / invoice / receipt on top of the owner's Canva artwork.
// The artwork already carries every fixed label ("Name:", "Location :", the
// PAYMENT TERMS wording, bank details, footer) — we only place the values.
//
// Positions are percentages of the page so the sheet scales identically on a
// phone, a desktop and A4 paper. Font sizes use cqw (1% of the sheet's width)
// for the same reason. Coordinates were measured against the 1240x1754 export;
// re-measure if the artwork is ever re-exported.
import { getT } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = getT(locale);
const d = t.documents;
---

<div id="doc-sheet" hidden class="doc-wrap mt-8">
  <div id="doc-page" class="doc-page" data-doc="page">
    <!-- Box interiors measured off the artwork: Name 5.73–31.13%, No. 32.58–57.98%,
         with their printed labels ending at 12.26% and 43.79%. -->
    <span class="fit s-base" data-doc="bill-nama" style="left:13.06%;top:11.03%;width:17.4%"></span>
    <!-- The "… No.:" label is a different width per type, so the script sets
         this span's left/width to clear whichever label is printed. -->
    <span class="fit s-base" data-doc="no" style="top:11.09%"></span>

    <!-- Address runs on its own lines under the label (baseline 17.33%), inside
         a box ending at 28.22%. data-maxh is that free height, so a long address
         shrinks rather than spilling past the border. -->
    <span class="wrap s-addr" data-doc="bill-alamat" data-maxh="10.4"
      style="left:7.26%;top:17.66%;width:48%"></span>

    <!-- Location and Date must stay on one line: the artwork prints the next
         label directly beneath them, so a wrapped line would collide with it.
         Time is the last label, so it can flow down into the empty cell. -->
    <span class="fit s-base" data-doc="lokasi" style="left:18.86%;top:55.04%;width:38%"></span>
    <span class="fit s-base" data-doc="tarikh" style="left:18.86%;top:56.98%;width:38%"></span>
    <span class="wrap s-base" data-doc="masa" data-maxh="6.0"
      style="left:18.86%;top:58.92%;width:38%"></span>

    <span class="wrap s-note" data-doc="payment" style="left:9.68%;top:65.0%;width:47%"></span>

    <!-- Table columns: Detail 7.90–58.55%, Rate 58.55–78.79%, Amount 78.79–97.42%.
         "fit" lets unusually long content (e.g. a custom-quote label) shrink
         instead of spilling into the next column. -->
    <span class="mid s-amt fit" data-doc="rate" style="left:59.05%;top:53.29%;width:19.2%"></span>
    <span class="mid s-amt fit" data-doc="amount" style="left:79.29%;top:53.29%;width:17.6%"></span>
    <span class="mid s-total fit" data-doc="total" style="left:79.29%;top:74.80%;width:17.6%"></span>
  </div>
</div>

<button type="button" id="print-btn" hidden
  class="pop gradient-green mt-6 w-full rounded-full px-7 py-4 font-display text-xl font-bold text-white shadow-xl shadow-mint/40">
  {d.print}
</button>

<style>
  .doc-wrap {
    /* Artwork is busy at small sizes; never let it shrink below readable */
    overflow-x: auto;
  }
  .doc-page {
    /* --u is 1% of the sheet width, set by JS on render and resize. Container
       query units would be the natural fit, but the build pipeline strips cqw
       from inline styles, so text silently fell back to the body size. */
    --u: 3px;
    position: relative;
    width: 100%;
    min-width: 320px;
    aspect-ratio: 1240 / 1754;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    /* Matches the Arial used by the pre-printed labels in the artwork */
    /* Arial and pure black, both measured off the artwork's own labels so the
       values read as part of the document rather than pasted on top. */
    font-family: Arial, Helvetica, sans-serif;
    color: #000;
    line-height: 1.25;
  }
  .doc-page > span {
    position: absolute;
    display: block;
    white-space: nowrap;
  }
  .doc-page > span.wrap {
    white-space: pre-line;
  }
  .doc-page > span.mid {
    text-align: center;
  }
  /* line-height is pinned in --u so a shrunk value keeps the same vertical
     centre as a full-size one — otherwise long names drift up off their label. */
  .doc-page > span.s-base {
    /* Matches the size of the pre-printed labels in the artwork (~2.05% of the
       page width) so values don't read as an afterthought next to them. */
    font-size: calc(var(--u) * 2.05);
    line-height: calc(var(--u) * 2.55);
  }
  /* Same type size as the labels, but tighter leading so a four-line address
     (street, town, state, phone) still clears the bottom of its box. */
  .doc-page > span.s-addr {
    font-size: calc(var(--u) * 2.05);
    line-height: calc(var(--u) * 2.35);
  }
  .doc-page > span.s-note {
    font-size: calc(var(--u) * 1.85);
    line-height: calc(var(--u) * 2.3);
  }
  .doc-page > span.s-amt {
    font-size: calc(var(--u) * 2.1);
    line-height: calc(var(--u) * 2.6);
  }
  .doc-page > span.s-total {
    font-size: calc(var(--u) * 2.4);
    line-height: calc(var(--u) * 3);
  }

  @media print {
    :global(body *) {
      visibility: hidden;
    }
    /* :global is required — these values are written by JS at runtime and so
       never carry Astro's scope attribute. Scoped selectors would hide them and
       print a blank template. */
    :global(#doc-sheet),
    :global(#doc-sheet *) {
      visibility: visible;
    }
    :global(#doc-sheet) {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      margin: 0 !important;
    }
    :global(.doc-page) {
      min-width: 0;
      width: 100%;
    }
    :global(html) {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    @page {
      size: A4;
      margin: 0;
    }
  }
</style>
