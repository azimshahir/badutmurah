---
// Package cards: 2 cards. Basic (durations picked on /booking) + Game Package.
// Data from docs/pricing.json (BM + _en fields), never hardcoded.
// `linkToPage` = true renders on /package (links to full /booking page);
// false = homepage teaser (also links to /booking, no anchors anymore).
import pricing from '../../docs/pricing.json';
import { getT, localePath } from '../i18n/index.js';

const { locale = 'en', standalone = false } = Astro.props;
const t = getT(locale);
const { pakej, currency } = pricing;
const f = (p, key) => p[t.pakej[key]];
const sesuaiKey = locale === 'en' ? 'sesuai_en' : 'sesuai';
const durasiKey = locale === 'en' ? 'durasi_en' : 'durasi';
const durasiTetapKey = locale === 'en' ? 'durasi_tetap_en' : 'durasi_tetap';

const basic = pakej.find((p) => p.id === 'basic');
const game = pakej.find((p) => p.id === 'meriah');
const bookHref = localePath(locale, '/booking');

// August promo. No date picker on these cards, so promo prices show for the
// whole promo period; flipping promo.aktif in pricing.json reverts everything.
const promo = pricing.promo?.aktif ? pricing.promo : null;
const promoHarga = (pakejId, durasiId) => {
  const entry = promo?.harga?.[pakejId];
  if (entry == null) return null;
  return typeof entry === 'number' ? entry : (entry[durasiId] ?? null);
};
const promoBasicFirst = promoHarga('basic', basic.durasi[0].id);
const promoGame = promoHarga('meriah');
const gamePrizeOptions = game.prize_options.map((amount) => `${currency}${amount}`).join(', ');
const gameHadiahOptions = (game.hadiah_options ?? []).map((id) => t.booking.hadiahOptions?.[id] ?? id);
---

<section id="pakej" class:list={['scroll-mt-28', !standalone && 'py-12 md:py-24']}>
  <div class="mx-auto max-w-[900px] px-4 sm:px-5">
    {
      !standalone && (
        <>
          <h2 class="squiggle mx-auto w-fit text-center text-2xl font-bold sm:text-3xl md:text-4xl">
            {t.pakej.heading}
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-center opacity-90">{t.pakej.sub}</p>
        </>
      )
    }

    <div class="mt-10 grid items-stretch gap-5 sm:mt-14 sm:gap-6 md:grid-cols-2 md:gap-8">
      <!-- Basic Package: duration options shown, price picked on /booking -->
      <article class="tilt relative flex flex-col rounded-[28px] border border-navy/5 bg-white p-5 shadow-lg sm:rounded-[40px] sm:p-8">
        <h3 class="text-xl font-semibold sm:text-2xl">{f(basic, 'nameKey')}</h3>
        <p class="mt-3 font-display text-[2.15rem] leading-none font-bold sm:mt-4 sm:text-[2.5rem]">
          {promoBasicFirst !== null && <s class="mr-2 text-xl opacity-40 sm:text-2xl">{currency}{basic.durasi[0].harga}</s>}
          <span class:list={[promoBasicFirst !== null && 'text-coral-dark']}>
            {currency}{promoBasicFirst ?? basic.durasi[0].harga}
          </span>
          <span class="mt-1 block text-sm font-semibold opacity-60 sm:mt-0 sm:inline sm:text-base">({basic.durasi[0][durasiKey]})</span>
        </p>
        {promo && (
          <span class="mt-2 w-fit rounded-full bg-coral px-3 py-1 text-xs font-bold tracking-wide text-white">
            {t.booking.promoBadge}
          </span>
        )}
        <ul class="mt-5 flex-1 space-y-2.5 text-[15px]">
          {f(basic, 'termasukKey').map((item) => (
            <li class="flex gap-2">
              <span class="mt-0.5 shrink-0 font-bold text-mint">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <!-- duration + suitability options -->
        <div class="mt-6 space-y-3">
          {basic.durasi.map((d) => (
            <div class="rounded-xl bg-cream p-3.5 sm:rounded-2xl sm:p-4">
              <p class="font-display text-base font-bold sm:text-lg">
                {d[durasiKey]}
                {d.harga !== null && (
                  promoHarga('basic', d.id) !== null ? (
                    <>
                      : <s class="font-normal opacity-40">{currency}{d.harga}</s>{' '}
                      <span class="text-coral-dark">{currency}{promoHarga('basic', d.id)}</span>
                    </>
                  ) : (
                    <>: {currency}{d.harga}</>
                  )
                )}
              </p>
              <p class="mt-1 text-sm opacity-80">{d[sesuaiKey]}</p>
            </div>
          ))}
        </div>

        <a
          href={bookHref}
          data-pakej="basic"
          class="pakej-cta pop mt-6 rounded-full border-2 border-navy/10 py-3.5 text-center font-display text-lg font-bold hover:border-coral/50 hover:bg-cream sm:py-4 sm:text-xl"
        >
          {t.pakej.book}
        </a>
      </article>

      <!-- Game Package (most popular) -->
      <article class="tilt relative flex flex-col rounded-[28px] border-4 border-white bg-sky p-5 pt-7 shadow-2xl sm:rounded-[40px] sm:p-8 md:-my-3 md:scale-[1.03] md:py-10">
        <span class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-white px-5 py-1.5 font-display text-sm font-bold whitespace-nowrap shadow-md">
          ⭐ {f(game, 'labelKey')}
        </span>
        <h3 class="text-xl font-semibold sm:text-2xl">{f(game, 'nameKey')}</h3>
        <p class="text-sm font-semibold opacity-70">{game[durasiTetapKey]}</p>
        <p class="mt-3 font-display text-[2.25rem] leading-none font-bold sm:mt-4 sm:text-[2.75rem]">
          {promoGame !== null && <s class="mr-2 text-xl opacity-40 sm:text-2xl">{currency}{game.harga}</s>}
          <span class:list={[promoGame !== null && 'text-coral-dark']}>
            {currency}{promoGame ?? game.harga}
          </span>
        </p>
        {promo && (
          <span class="mt-2 w-fit rounded-full bg-coral px-3 py-1 text-xs font-bold tracking-wide text-white">
            {t.booking.promoBadge}
          </span>
        )}
        <p class="mt-3 text-sm opacity-80">{game[sesuaiKey]}</p>
        <p class="mt-2 text-sm font-semibold">{t.booking.pilihHadiah}</p>
        <ul class="mt-1 space-y-1 text-sm">
          {gameHadiahOptions.map((o) => <li>• {o}</li>)}
        </ul>
        <p class="mt-2 text-sm font-semibold">{t.booking.prizeOptions.replace('{options}', gamePrizeOptions)}</p>
        <ul class="mt-5 flex-1 space-y-2.5 text-[15px]">
          {f(game, 'termasukKey').map((item) => (
            <li class="flex gap-2">
              <span class="mt-0.5 shrink-0 font-bold text-mint">✓</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <a
          href={bookHref}
          data-pakej="meriah"
          class="pakej-cta pop gradient-pink mt-7 rounded-full py-3.5 text-center font-display text-lg font-bold text-white shadow-lg shadow-coral/30 sm:py-4 sm:text-xl"
        >
          {t.pakej.book}
        </a>
      </article>
    </div>

    <p class="mt-8 text-center text-sm opacity-80">{t.pakej.nota}</p>
  </div>
</section>

<script>
  // Remember the chosen package so /booking can preselect it.
  document.querySelectorAll('.pakej-cta').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-pakej');
      if (id) sessionStorage.setItem('badutmurah_pakej', id);
    });
  });
</script>
