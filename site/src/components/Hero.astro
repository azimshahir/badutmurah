---
// Hero: centered headline + photo marquee scrolling right + 4 pill CTAs
import { getT, localePath } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = getT(locale);
const bookHref = localePath(locale, '/booking');
const pakejHref = localePath(locale, '/package');

const strip = [
  { src: '/images/hero.webp', alt: 'Badut Jim at a birthday party with a family' },
  { src: '/images/gallery-1.webp', alt: 'Badut Jim doing balloon twisting for kids at an event' },
  { src: '/images/gallery-2.webp', alt: 'Badut Jim entertaining a family with balloons' },
  { src: '/images/gallery-3.webp', alt: 'Happy kids with balloons next to Badut Jim' },
  { src: '/images/gallery-4.webp', alt: 'Badut Jim in full costume at an event' },
  { src: '/images/gallery-5.webp', alt: 'Badut Jim at a corporate event with balloons and confetti' },
  { src: '/images/gallery-6.webp', alt: 'Bouncing castle at a birthday party' },
  { src: '/images/gallery-7.webp', alt: 'Kids watching a puppet show' },
];
---

<header id="top" class="relative overflow-hidden pt-9 pb-12 md:pt-16 md:pb-16">
  <svg viewBox="0 0 40 64" class="pointer-events-none absolute top-24 left-[6%] hidden h-16 w-10 -rotate-12 md:block" aria-hidden="true">
    <ellipse cx="20" cy="18" rx="14" ry="17" fill="#EF476F" opacity="0.5"></ellipse>
    <path d="M20 40 C 18 48, 24 52, 20 62" stroke="#1D3557" stroke-width="1.5" fill="none" opacity="0.4"></path>
  </svg>
  <svg viewBox="0 0 40 64" class="pointer-events-none absolute top-16 right-[8%] hidden h-14 w-9 rotate-12 md:block" aria-hidden="true">
    <ellipse cx="20" cy="18" rx="14" ry="17" fill="#FFD166" opacity="0.6"></ellipse>
    <path d="M20 40 C 22 48, 16 52, 20 62" stroke="#1D3557" stroke-width="1.5" fill="none" opacity="0.4"></path>
  </svg>
  <svg viewBox="0 0 48 32" class="pointer-events-none absolute top-8 left-[30%] h-8 w-12" aria-hidden="true">
    <circle cx="8" cy="20" r="3" fill="#FFD166" opacity="0.8"></circle>
    <circle cx="24" cy="8" r="2.5" fill="#06D6A0" opacity="0.8"></circle>
    <rect x="36" y="16" width="6" height="6" rx="1.5" fill="#EF476F" opacity="0.6" transform="rotate(20 39 19)"></rect>
  </svg>

  <div class="mx-auto max-w-[860px] px-4 text-center sm:px-5">
    <h1 class="text-3xl leading-tight font-bold sm:text-4xl md:text-6xl">{t.hero.headline}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-base opacity-90 sm:mt-5 sm:text-lg">{t.hero.sub}</p>
    <ul class="mt-5 grid grid-cols-2 gap-x-3 gap-y-2 text-left text-sm font-semibold sm:mt-6 sm:flex sm:flex-wrap sm:justify-center sm:gap-x-6">
      {t.hero.trust.map((item) => (
        <li class="flex items-center gap-1.5"><span class="text-mint">✓</span> {item}</li>
      ))}
    </ul>
  </div>

  <div class="mt-8 overflow-hidden sm:mt-10" aria-label={t.hero.marqueeLabel}>
    <div class="marquee-track gap-3 pr-3 sm:gap-4 sm:pr-4">
      {
        [...strip, ...strip].map((g, i) => (
          <img
            src={g.src}
            alt={i < strip.length ? g.alt : ''}
            aria-hidden={i >= strip.length ? 'true' : undefined}
            loading={i < 4 ? 'eager' : 'lazy'}
            decoding="async"
            width="300"
            height="225"
            class="h-36 w-auto shrink-0 rounded-xl object-cover shadow-md sm:h-44 sm:rounded-2xl md:h-56"
          />
        ))
      }
    </div>
  </div>

  <div class="relative mx-auto mt-8 grid w-full max-w-md grid-cols-2 gap-2 px-4 sm:mt-10 sm:flex sm:w-fit sm:max-w-full sm:flex-wrap sm:items-center sm:justify-center sm:gap-3 sm:px-5 md:gap-4">
    <!-- sparkle doodles around the button row -->
    <svg viewBox="0 0 24 24" class="pointer-events-none absolute -top-5 -left-6 h-6 w-6 text-sunny" aria-hidden="true">
      <path d="M12 0 L14 9 L23 12 L14 15 L12 24 L10 15 L1 12 L10 9 Z" fill="currentColor"></path>
    </svg>
    <svg viewBox="0 0 24 24" class="pointer-events-none absolute -right-7 -bottom-4 h-5 w-5 text-coral/70" aria-hidden="true">
      <path d="M12 0 L14 9 L23 12 L14 15 L12 24 L10 15 L1 12 L10 9 Z" fill="currentColor"></path>
    </svg>
    <svg viewBox="0 0 24 24" class="pointer-events-none absolute -top-4 right-10 h-4 w-4 text-mint/80" aria-hidden="true">
      <path d="M12 0 L14 9 L23 12 L14 15 L12 24 L10 15 L1 12 L10 9 Z" fill="currentColor"></path>
    </svg>

    <a
      href={pakejHref}
      class="pop flex min-h-12 items-center justify-center rounded-2xl border-2 border-coral/30 bg-white px-3 py-3 text-center font-display text-sm leading-tight font-bold text-coral-dark shadow-md hover:border-coral sm:rounded-full sm:px-7 sm:py-3.5 sm:text-xl"
    >
      🎁 {t.hero.ctaPakej}
    </a>
    <a
      href={bookHref}
      class="pop gradient-pink relative flex min-h-12 items-center justify-center rounded-2xl px-3 py-3 text-center font-display text-sm leading-tight font-bold text-white shadow-xl shadow-coral/30 ring-4 ring-coral/15 sm:rounded-full sm:px-8 sm:py-3.5 sm:text-xl"
    >
      ⭐ {t.hero.ctaBook}
    </a>
    <a
      href="#gallery"
      class="pop flex min-h-12 items-center justify-center rounded-2xl border-2 border-navy/15 bg-white px-3 py-3 text-center font-display text-sm leading-tight font-bold shadow-md hover:border-coral/50 sm:rounded-full sm:px-7 sm:py-3.5 sm:text-xl"
    >
      📸 {t.hero.ctaGallery}
    </a>
    <a
      href="#faq"
      class="pop flex min-h-12 items-center justify-center rounded-2xl border-2 border-navy/15 bg-white px-3 py-3 text-center font-display text-sm leading-tight font-bold shadow-md hover:border-coral/50 sm:rounded-full sm:px-7 sm:py-3.5 sm:text-xl"
    >
      ❓ {t.hero.ctaFaq}
    </a>
  </div>
</header>
