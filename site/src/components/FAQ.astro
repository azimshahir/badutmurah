---
// FAQ pill rows with emoji icons. Copy from i18n dicts (synced with docs/content.md)
import { getT } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = getT(locale);
---

<section id="faq" class="scroll-mt-28 py-12 md:py-24">
  <div class="mx-auto max-w-[760px] px-4 sm:px-5">
    <h2 class="squiggle mx-auto w-fit text-center text-2xl font-bold sm:text-3xl md:text-4xl">
      {t.faq.heading}
    </h2>

    <div class="mt-8 space-y-2.5 sm:mt-10 sm:space-y-3">
      {
        t.faq.items.map((item) => (
          <details class="group rounded-xl bg-white p-3 shadow-sm transition-shadow open:shadow-md hover:shadow-md sm:rounded-2xl sm:p-4">
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2.5 font-display text-base font-bold sm:gap-3 sm:text-lg [&::-webkit-details-marker]:hidden">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cream text-base sm:h-9 sm:w-9 sm:text-lg" aria-hidden="true">
                {item.emoji}
              </span>
              <span class="flex-1">{item.q}</span>
              <span class="shrink-0 text-sm text-coral transition-transform group-open:rotate-180" aria-hidden="true">▼</span>
            </summary>
            <p class="mt-2 pr-1 pl-10 text-sm opacity-80 sm:pr-2 sm:pl-12 sm:text-[15px]">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
