---
// "Our Clown" story page. Draft content: owner to review before final.
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import SocialIcons from './SocialIcons.astro';
import { getT, localePath } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = getT(locale);
const pathname = localePath(locale, '/our-clown');

const photos = ['/images/gallery-4.webp', '/images/gallery-1.webp', '/images/gallery-5.webp'];
---

<Layout locale={locale} title={t.meta.titleOurClown} description={t.meta.descriptionOurClown} pathname={pathname}>
  <Navbar locale={locale} pathname={pathname} />
  <main class="mx-auto max-w-[860px] px-4 py-10 sm:px-5 sm:py-14 md:py-20">
    <p class="mx-auto mb-4 block w-fit rounded-full bg-sky px-4 py-1 text-center font-display text-sm font-bold">
      🎈 {t.hero.expertise}
    </p>
    <h1 class="squiggle mx-auto w-fit text-center text-3xl font-bold sm:text-4xl md:text-5xl">
      {t.ourClown.heading}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-base opacity-90 sm:mt-6 sm:text-lg">{t.ourClown.intro}</p>

    <div class="mt-10 space-y-10 sm:mt-14 sm:space-y-14">
      {
        t.ourClown.sections.map((s, i) => (
          <div class:list={['flex flex-col items-center gap-5 sm:gap-8 md:flex-row', i % 2 === 1 && 'md:flex-row-reverse']}>
            <figure class:list={['tilt w-full shrink-0 rounded-xl bg-white p-2.5 pb-4 shadow-lg md:w-80', i % 2 ? 'rotate-2' : '-rotate-2']}>
              <img
                src={photos[i]}
                alt={s.tajuk}
                loading="lazy"
                decoding="async"
                width="400"
                height="300"
                class="aspect-[4/3] w-full rounded-lg object-cover"
              />
            </figure>
            <div>
              <h2 class="text-xl font-semibold sm:text-2xl">{s.tajuk}</h2>
              <p class="mt-3 opacity-90">{s.isi}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Jim The Clown Social Media -->
    <section class="mt-12 rounded-[28px] bg-white p-5 text-center shadow-lg sm:mt-16 sm:rounded-[40px] sm:p-8 md:p-10">
      <h2 class="squiggle mx-auto w-fit text-2xl font-bold md:text-3xl">
        {t.ourClown.socialHeading}
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <SocialIcons size="h-14 w-14" withFacebook={true} />
      </div>
    </section>

    <p class="mt-12 text-center">
      <a
        href={localePath(locale, '/booking')}
        class="pop gradient-pink inline-flex min-h-12 items-center justify-center rounded-full px-6 py-3.5 font-display text-lg font-bold text-white shadow-lg shadow-coral/40 sm:px-9 sm:py-4 sm:text-xl"
      >
        {t.ourClown.cta}
      </a>
    </p>
  </main>
  <Footer locale={locale} />
  <WhatsAppButton locale={locale} />
</Layout>
