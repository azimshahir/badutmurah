---
// /documents — customer enters the phone they booked with, picks a booking, and
// gets a quotation / invoice / receipt. All data comes from Hermes via
// POST /api/documents. Spec: docs/documents-spec.md.
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import DocumentSheet from './DocumentSheet.astro';
import { getT, getWhatsAppLink, localePath } from '../i18n/index.js';

const { locale = 'en' } = Astro.props;
const t = getT(locale);
const d = t.documents;
const waLink = getWhatsAppLink(locale);
const pathname = localePath(locale, '/documents');
---

<Layout
  locale={locale}
  title={d.heading + ' | badutmurah.my'}
  description={d.metaDescription}
  pathname={pathname}
  noindex
>
  <Navbar locale={locale} pathname={pathname} />
  <main
    class="mx-auto max-w-[760px] px-5 py-14 md:py-20"
    data-msg-searching={d.searching}
    data-msg-search={d.search}
    data-msg-generating={d.generating}
    data-msg-generate={d.generate}
    data-msg-error={d.errorGeneric}
    data-msg-error-suffix={d.errorSuffix}
    data-msg-error-wa={d.errorWhatsapp}
    data-msg-error-phone={d.errorPhone}
    data-msg-error-nama={d.errorNama}
    data-msg-error-not-found={d.errorNotFound}
    data-msg-error-not-available={d.errorNotAvailable}
    data-msg-error-rate-limit={d.errorRateLimit}
    data-msg-error-unavailable={d.errorUnavailable}
    data-msg-no-bookings={d.noBookings}
    data-msg-locked-invoice={d.lockedInvoice}
    data-msg-locked-receipt={d.lockedReceipt}
    data-label-quotation={d.quotation}
    data-label-invoice={d.invoice}
    data-label-receipt={d.receipt}
    data-label-travel={d.travelFee}
    data-wa-link={waLink}
    data-locale={locale}
  >
    <h1 class="squiggle mx-auto w-fit text-center text-3xl font-bold md:text-4xl">{d.heading}</h1>
    <p class="mx-auto mt-4 max-w-lg text-center opacity-90">{d.sub}</p>

    <!-- Step 1: find bookings by phone -->
    <form id="lookup-form" class="mt-10 rounded-[40px] border border-navy/5 bg-white p-6 shadow-2xl md:p-10" novalidate>
      <label for="phone" class="mb-1.5 block font-semibold">{d.phoneLabel}</label>
      <input type="tel" id="phone" name="phone" required inputmode="tel" autocomplete="tel" placeholder="01X-XXXXXXX"
        class="w-full rounded-xl border-none bg-navy/5 px-4 py-3.5 outline-none transition focus:ring-2 focus:ring-coral" />

      <!-- Honeypot: hidden from humans, bots fill it in -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" id="lookup-btn"
        class="pop gradient-pink mt-5 w-full rounded-full px-7 py-4 font-display text-xl font-bold text-white shadow-xl shadow-coral/30 disabled:opacity-60">
        {d.search}
      </button>
    </form>

    <p id="form-error" hidden class="mt-5 rounded-2xl bg-coral/10 p-4 text-[15px] font-semibold text-coral-dark"></p>

    <!-- Step 2: pick a booking -->
    <section id="bookings" hidden class="mt-8">
      <h2 class="font-display text-xl font-bold">{d.bookingsHeading}</h2>
      <div id="bookings-list" class="mt-4 space-y-3"></div>
    </section>

    <!-- Step 3: edit the bill-to block, then the document renders below -->
    <section id="billing" hidden class="mt-8 rounded-3xl border border-navy/5 bg-white p-6 shadow-lg md:p-8">
      <h2 class="font-display text-xl font-bold">{d.billingHeading}</h2>
      <p class="mt-1 text-sm opacity-70">{d.billingHint}</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="b-nama" class="mb-1.5 block text-sm font-semibold">{d.billNama}</label>
          <input type="text" id="b-nama" class="w-full rounded-xl border-none bg-navy/5 px-4 py-3 outline-none transition focus:ring-2 focus:ring-coral" />
        </div>
        <div>
          <label for="b-phone" class="mb-1.5 block text-sm font-semibold">{d.billPhone}</label>
          <input type="tel" id="b-phone" class="w-full rounded-xl border-none bg-navy/5 px-4 py-3 outline-none transition focus:ring-2 focus:ring-coral" />
        </div>
        <div class="sm:col-span-2">
          <label for="b-alamat" class="mb-1.5 block text-sm font-semibold">{d.billAlamat}</label>
          <textarea id="b-alamat" rows="2" class="w-full rounded-xl border-none bg-navy/5 px-4 py-3 outline-none transition focus:ring-2 focus:ring-coral"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label for="b-email" class="mb-1.5 block text-sm font-semibold">{d.billEmail}</label>
          <input type="email" id="b-email" class="w-full rounded-xl border-none bg-navy/5 px-4 py-3 outline-none transition focus:ring-2 focus:ring-coral" />
        </div>
      </div>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <button type="button" id="generate-btn"
          class="pop gradient-pink flex-1 rounded-full px-7 py-3.5 font-display text-lg font-bold text-white shadow-lg shadow-coral/30 disabled:opacity-60">
          {d.generate}
        </button>
        <button type="button" id="back-btn"
          class="rounded-full border-2 border-navy/10 px-7 py-3.5 font-display text-lg font-bold transition hover:bg-cream">
          {d.back}
        </button>
      </div>
    </section>

    <DocumentSheet locale={locale} />
  </main>
  <Footer locale={locale} />
  <WhatsAppButton locale={locale} />
</Layout>

<script>
  const root = document.querySelector('main') as HTMLElement;
  const msg = root.dataset;
  const form = document.getElementById('lookup-form') as HTMLFormElement;
  const phoneInput = document.getElementById('phone') as HTMLInputElement;
  const lookupBtn = document.getElementById('lookup-btn') as HTMLButtonElement;
  const errorBox = document.getElementById('form-error') as HTMLParagraphElement;
  const bookingsBox = document.getElementById('bookings') as HTMLElement;
  const bookingsList = document.getElementById('bookings-list') as HTMLElement;
  const billingBox = document.getElementById('billing') as HTMLElement;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
  const backBtn = document.getElementById('back-btn') as HTMLButtonElement;
  const printBtn = document.getElementById('print-btn') as HTMLButtonElement;
  const sheet = document.getElementById('doc-sheet') as HTMLElement;
  const page = document.getElementById('doc-page') as HTMLElement;

  const TYPES = ['quotation', 'invoice', 'receipt'] as const;
  type DocType = (typeof TYPES)[number];

  // Phone is kept in memory only — never in the URL, so it can't leak via
  // browser history, referrer headers or server logs.
  let phone = '';
  let selected: { lead_id: string; type: DocType } | null = null;
  // Browsers name the "Save as PDF" file after document.title, so the rendered
  // document's identity is kept here and swapped in just for the print.
  let printName = '';

  const label = (type: DocType) =>
    ({ quotation: msg.labelQuotation!, invoice: msg.labelInvoice!, receipt: msg.labelReceipt! })[type];

  const money = (n: number) => `RM${Number(n).toFixed(2)}`;

  // "1 hour" reads better as "/hour"; longer spans keep their number ("/2 hours")
  const perUnit = (s: string) => s.trim().replace(/^1\s+(jam|hour)$/i, '$1');

  // ---- Time normalisation -------------------------------------------------
  // `masa` is free text the customer typed ("7PM", "10pg", "3.30 petang"), so a
  // document would otherwise show a different format for every booking. Parse
  // it, add the package duration, and print one house style:
  //   10.00 a.m. - 11.00 a.m.
  //   10.00 a.m. - 11.00 a.m. , 3.00 p.m. - 4.00 p.m.

  // Minutes in "1 hour" / "1 jam 30 minit" / "1 hour 30 minutes"
  function durationMinutes(d: string): number {
    if (!d) return 0;
    const s = d.toLowerCase();
    const h = s.match(/(\d+)\s*(jam|hour)/);
    // plural must be allowed: "30 minutes" has no word boundary after "minute"
    const m = s.match(/(\d+)\s*(?:minit|minutes?|mins?)\b/);
    return (h ? +h[1] * 60 : 0) + (m ? +m[1] : 0);
  }

  // One clock time -> minutes past midnight, or null when it can't be read
  function parseClock(raw: string): number | null {
    const s = raw.toLowerCase().replace(/\s+/g, '');
    const m = s.match(/^(\d{1,2})(?:[.:](\d{2}))?(.*)$/);
    if (!m) return null;
    let h = +m[1];
    const min = m[2] ? +m[2] : 0;
    if (h > 23 || min > 59) return null;

    const suffix = (m[3] || '').replace(/\./g, '');
    let pm: boolean | null = null;
    if (/^(am|pagi|pg)/.test(suffix)) pm = false;
    else if (/^(pm|petang|ptg|tengahari|tgahari|tgh)/.test(suffix)) pm = true;
    else if (/^(malam|mlm)/.test(suffix)) pm = h === 12 ? false : true; // "12 malam" = midnight

    if (pm === null) {
      if (h >= 13) return h * 60 + min; // already 24-hour
      return null; // ambiguous — better to leave the customer's text alone
    }
    if (pm && h < 12) h += 12;
    if (!pm && h === 12) h = 0;
    return h * 60 + min;
  }

  function clockLabel(mins: number): string {
    const t = ((mins % 1440) + 1440) % 1440;
    const h24 = Math.floor(t / 60);
    const h12 = h24 % 12 || 12;
    const mm = String(t % 60).padStart(2, '0');
    return `${h12}.${mm} ${h24 < 12 ? 'a.m.' : 'p.m.'}`;
  }

  function formatMasa(raw: string, durasi: string): string {
    if (!raw) return '';
    const sessions = raw.split(/\s*(?:[+&,/]|\bdan\b|\band\b)\s*/i).filter(Boolean);
    const span = durationMinutes(durasi);
    const parts: string[] = [];
    for (const s of sessions) {
      const start = parseClock(s);
      if (start === null) return raw; // unreadable — never invent a time
      parts.push(span > 0 ? `${clockLabel(start)} - ${clockLabel(start + span)}` : clockLabel(start));
    }
    // One session per line — two ranges on a single line runs past the cell
    return parts.join('\n');
  }

  const el = (sel: string) => sheet.querySelector<HTMLElement>(`[data-doc="${sel}"]`)!;

  function showError(text: string) {
    errorBox.innerHTML = `${text} ${msg.msgErrorSuffix} <a href="${msg.waLink}" target="_blank" rel="noopener" class="underline">${msg.msgErrorWa}</a>.`;
    errorBox.hidden = false;
  }

  // The API returns a code, not prose, so the message matches the page language
  const CODE_MESSAGES: Record<string, string | undefined> = {
    bad_phone: msg.msgErrorPhone,
    bad_name: msg.msgErrorNama,
    not_found: msg.msgErrorNotFound,
    not_available: msg.msgErrorNotAvailable,
    rate_limited: msg.msgErrorRateLimit,
    unavailable: msg.msgErrorUnavailable,
  };

  // Sample data for local previewing — `astro dev` doesn't run Pages Functions,
  // so /api/documents is unreachable here. import.meta.env.DEV is false during
  // `npm run build`, so this whole block is stripped from the production bundle.
  const DEMO_PHONE = '0111111111';
  function demo(payload: any) {
    if (!import.meta.env.DEV || payload.phone !== DEMO_PHONE) return null;
    if (payload.action === 'list') {
      return { ok: true, bookings: [{
        lead_id: 'demo', tarikh: '2026-08-14', pakej: 'Basic Package',
        status: 'completed', available: TYPES,
      }] };
    }
    const paid = { deposit: { amount: 100, date: '20 Jul 2026' }, balance: { amount: 260, date: '14 Aug 2026' }, outstanding: 0 };
    return { ok: true, document: {
      type: payload.type,
      doc_no: { quotation: 'Q-26-0005', invoice: 'INV-26-0003', receipt: 'BJ-26-0007' }[payload.type as DocType],
      billing: payload.billing,
      event: { tarikh: '14 August 2026', masa: '10.00 pagi + 3.00 petang', lokasi: 'Taman Meru, Klang', durasi: '1 hour' },
      items: [{ desc: 'Clown Appearance with Balloon Sculpture', qty: '1 hour', rate: 180, amount: 360 }],
      travel_fee: 0, total: 360, deposit_required: 100,
      payment: payload.type === 'quotation' ? {} : paid,
    } };
  }

  async function post(payload: Record<string, unknown>) {
    const sample = demo(payload);
    if (sample) return sample;
    const res = await fetch('/api/documents', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const json = await res.json();
    if (!json.ok) throw new Error(CODE_MESSAGES[json.code] ?? msg.msgError!);
    return json;
  }

  // ---- Step 1: look up bookings ----
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    bookingsBox.hidden = true;
    billingBox.hidden = true;
    sheet.hidden = true;
    printBtn.hidden = true;

    const raw = phoneInput.value.replace(/[\s-]/g, '');
    if (!/^01[0-9]{8,9}$/.test(raw)) {
      showError(msg.msgErrorPhone!);
      return;
    }
    phone = raw;

    lookupBtn.disabled = true;
    lookupBtn.textContent = msg.msgSearching!;
    try {
      const { bookings } = await post({
        action: 'list',
        phone,
        website: (document.getElementById('website') as HTMLInputElement).value,
      });
      renderBookings(bookings);
    } catch (err) {
      showError(err instanceof Error ? err.message : msg.msgError!);
    } finally {
      lookupBtn.disabled = false;
      lookupBtn.textContent = msg.msgSearch!;
    }
  });

  function renderBookings(bookings: any[]) {
    bookingsList.replaceChildren();
    if (!bookings.length) {
      const p = document.createElement('p');
      p.className = 'rounded-2xl bg-cream p-4 text-[15px]';
      p.textContent = msg.msgNoBookings!;
      bookingsList.append(p);
      bookingsBox.hidden = false;
      return;
    }

    for (const b of bookings) {
      const card = document.createElement('div');
      card.className = 'rounded-2xl border border-navy/10 bg-white p-4';

      const head = document.createElement('p');
      head.className = 'font-display font-bold';
      head.textContent = `${b.tarikh} — ${b.pakej}`;
      card.append(head);

      const row = document.createElement('div');
      row.className = 'mt-3 flex flex-wrap gap-2';
      for (const type of TYPES) {
        const available = (b.available ?? []).includes(type);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = label(type);
        if (available) {
          btn.className =
            'rounded-full border-2 border-coral/40 px-4 py-2 text-sm font-semibold transition hover:bg-coral/10';
          btn.addEventListener('click', () => chooseDocument(b, type));
        } else {
          btn.className = 'cursor-not-allowed rounded-full border-2 border-navy/10 px-4 py-2 text-sm font-semibold opacity-40';
          btn.disabled = true;
          btn.title = type === 'receipt' ? msg.msgLockedReceipt! : msg.msgLockedInvoice!;
        }
        row.append(btn);
      }
      card.append(row);

      // Explain why a type is unavailable — a greyed button with no reason is a dead end
      const locked = TYPES.filter((tp) => !(b.available ?? []).includes(tp));
      if (locked.length) {
        const note = document.createElement('p');
        note.className = 'mt-2 text-xs opacity-60';
        note.textContent = locked.includes('receipt' as DocType) ? msg.msgLockedReceipt! : msg.msgLockedInvoice!;
        card.append(note);
      }

      bookingsList.append(card);
    }
    bookingsBox.hidden = false;
  }

  // ---- Step 2: prefill the bill-to block, then generate ----
  function chooseDocument(booking: any, type: DocType) {
    selected = { lead_id: booking.lead_id, type };
    billingBox.hidden = false;
    sheet.hidden = true;
    printBtn.hidden = true;
    errorBox.hidden = true;
    billingBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  backBtn.addEventListener('click', () => {
    billingBox.hidden = true;
    sheet.hidden = true;
    printBtn.hidden = true;
    bookingsBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  generateBtn.addEventListener('click', async () => {
    if (!selected) return;
    errorBox.hidden = true;

    const billing = {
      nama: (document.getElementById('b-nama') as HTMLInputElement).value,
      alamat: (document.getElementById('b-alamat') as HTMLTextAreaElement).value,
      phone: (document.getElementById('b-phone') as HTMLInputElement).value,
      email: (document.getElementById('b-email') as HTMLInputElement).value,
    };

    generateBtn.disabled = true;
    generateBtn.textContent = msg.msgGenerating!;
    try {
      const { document: doc } = await post({
        action: 'issue',
        phone,
        lead_id: selected.lead_id,
        type: selected.type,
        billing,
      });
      // Hermes fills in anything the customer left blank — reflect that back
      fillBilling(doc.billing);
      renderDocument(doc);
    } catch (err) {
      showError(err instanceof Error ? err.message : msg.msgError!);
    } finally {
      generateBtn.disabled = false;
      generateBtn.textContent = msg.msgGenerate!;
    }
  });

  function fillBilling(billing: any) {
    (document.getElementById('b-nama') as HTMLInputElement).value = billing?.nama ?? '';
    (document.getElementById('b-alamat') as HTMLTextAreaElement).value = billing?.alamat ?? '';
    (document.getElementById('b-phone') as HTMLInputElement).value = billing?.phone ?? '';
    (document.getElementById('b-email') as HTMLInputElement).value = billing?.email ?? '';
  }

  // ---- Step 3: place values onto the artwork ----
  function renderDocument(doc: any) {
    const type = doc.type as DocType;
    const ev = doc.event ?? {};
    const b = doc.billing ?? {};

    // Each type has its own artwork (the title and "… No." label are printed in it)
    page.style.backgroundImage = `url("/images/doc-${type}.webp")`;

    // Only the address is printed. Phone and email are still collected and kept
    // in Hermes for Jim, but the artwork's box only has room for ~4 lines and
    // padding it out forced the whole block to shrink to stay inside the border.
    const addressLines = b.alamat ?? '';

    el('bill-nama').textContent = b.nama ?? '';
    el('bill-alamat').textContent = addressLines;
    // Each artwork prints a different "… No.:" label, so start the value just
    // past whichever one this type uses and run to the box edge (57.4%).
    const labelEnd: Record<DocType, number> = { quotation: 46.29, invoice: 43.79, receipt: 44.27 };
    const noLeft = labelEnd[type] + 0.8;
    const noEl = el('no');
    noEl.style.left = `${noLeft}%`;
    noEl.style.width = `${57.4 - noLeft}%`;
    noEl.textContent = doc.doc_no ?? '';

    printName = `[${label(type)}] badutmurah.my (${doc.doc_no ?? ''})`;

    el('lokasi').textContent = ev.lokasi ?? '';
    el('tarikh').textContent = ev.tarikh ?? '';
    el('masa').textContent = formatMasa(ev.masa ?? '', ev.durasi || doc.items?.[0]?.qty || '');

    // One row only, per the artwork: rate is the package rate, amount folds in
    // travel so the column still adds up to the printed Total.
    const items = doc.items ?? [];
    const itemsTotal = items.reduce((sum: number, i: any) => sum + (i.amount ?? 0), 0);
    const travel = doc.travel_fee ?? 0;
    // Rate is a UNIT price ("RM180/hour"), not the line total — a customer who
    // books two separate hours should be able to see how the amount was reached.
    const unit = items[0]?.qty || ev.durasi || '';
    el('rate').textContent =
      items[0]?.rate != null ? `${money(items[0].rate)}${unit ? `/${perUnit(unit)}` : ''}` : '';
    el('amount').textContent = money(itemsTotal + travel);
    el('total').textContent = money(doc.total ?? itemsTotal + travel);

    // Free space under Time. Payment history is deliberately not printed — the
    // document type and its number already say where the booking stands.
    const notes: string[] = [];
    if (travel) notes.push(`${msg.labelTravel}: ${money(travel)}`);
    el('payment').textContent = notes.join('\n');

    sheet.hidden = false;
    printBtn.hidden = false;
    shrinkToFit();
    sheet.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // A long company name would run past its box and over the next field. Step the
  // font down until it fits rather than letting it collide.
  function shrinkToFit() {
    // 1% of the sheet width — every font size on the page is a multiple of this
    page.style.setProperty('--u', `${page.getBoundingClientRect().width / 100}px`);
    for (const node of page.querySelectorAll<HTMLElement>('.fit')) {
      node.style.fontSize = '';
      const base = parseFloat(getComputedStyle(node).fontSize);
      let size = base;
      while (node.scrollWidth > node.clientWidth && size > base * 0.5) {
        size -= base * 0.05;
        node.style.fontSize = `${size}px`;
      }
    }

    // Wrapping blocks (the address) are bounded by the height of their box
    const pageH = page.getBoundingClientRect().height;
    for (const node of page.querySelectorAll<HTMLElement>('[data-maxh]')) {
      node.style.fontSize = '';
      const maxH = (parseFloat(node.dataset.maxh!) / 100) * pageH;
      const base = parseFloat(getComputedStyle(node).fontSize);
      let size = base;
      while (node.scrollHeight > maxH && size > base * 0.6) {
        size -= base * 0.05;
        node.style.fontSize = `${size}px`;
      }
    }
  }

  // Re-fit after a resize, since the sheet and its type scale with the viewport
  window.addEventListener('resize', () => {
    if (!sheet.hidden) shrinkToFit();
  });

  // Restore on afterprint rather than straight after print() — the dialog is
  // async, and the title has to still be in place when the browser reads it.
  const pageTitle = document.title;
  window.addEventListener('afterprint', () => {
    document.title = pageTitle;
  });
  printBtn.addEventListener('click', () => {
    if (printName) document.title = printName;
    window.print();
  });
</script>
